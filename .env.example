# Application Environment
APP_ENV=dev
APP_DEBUG=1

app.config.code=appAPI
app.config.name="My Project"
app.config.version="1.0"
app.config.language=en
app.config.allow_god_mode=true
app.time.timezone=Asia/Jakarta

app.pagination.defaultPageSize=10
app.pagination.maxPageSize=100

app.rateLimit.maxRequests=100
app.rateLimit.windowSize=60

app.hsts.maxAge=31536000
app.hsts.includeSubDomains=true
app.hsts.preload=false

app.cors.allowedOrigins=["http://example.com:3000"]
app.cors.maxAge=86400
app.cors.allowCredentials=true
app.cors.allowedMethods=["GET","POST","PUT","PATCH","DELETE","OPTIONS"]
app.cors.allowedHeaders=["Content-Type","Authorization","X-Requested-With","Accept","Origin"]
app.cors.exposedHeaders=["X-Pagination-Total-Count","X-Pagination-Page-Count"]

app.trusted_hosts.allowedHosts=["127.0.0.1","::1","localhost"]

# Optimistic Lock Configuration
app.optimistic_lock.enabled=true
app.optimistic_lock.disabled.values=["example","example_1"]

# SSO Configuration (External Keycloak)
app.jwt.secret=secret-key-harus-panjang-256-bit
app.jwt.algorithm=HS256
app.jwt.issuer=https://sso.example.com
app.jwt.audience=https://sso.example.com
app.jwt.publicPaths=["/","/auth/login","/auth/refresh"]

# Monitoring & Structured Logging
app.monitoring.request_id_header=X-Request-Id
app.monitoring.logging.enabled=true

# Minimum level yang dicatat: debug | info | warning | error
app.monitoring.logging.log_level=warning
app.monitoring.logging.include_request_body=false
app.monitoring.logging.include_response_body=false

# Batas panjang body/value yang dicatat (karakter), selebihnya di-truncate
app.monitoring.logging.max_log_size=10000
app.monitoring.logging.exclude_paths=["/health","/metrics"]
app.monitoring.metrics.enabled=true
app.monitoring.error_monitoring.enabled=true

# Service Token auth (opt-in): opaque bearer via service_tokens table
app.service_token.enabled=false

# Connection for Redis
# redis.default.enabled=false
# redis.default.host=
# redis.default.port=
# redis.default.db=
# redis.default.password=

# Database MongoDB Connection
db.mongodb.enabled=true
db.mongodb.dsn=localhost:27017
db.mongodb.name=db_example
db.mongodb.connectTimeoutMS=500
db.mongodb.socketTimeoutMS=500
db.mongodb.readPreference=nearest

# Database: pgsql | mysql | mariadb
config.driver=pgsql
config.host=localhost
config.port=5432
config.charset=utf8mb4

db.default.driver=${config.driver}
db.default.host=${config.host}
db.default.port=${config.port}
db.default.charset=${config.charset}
db.default.name=
db.default.user=
db.default.password=

# Extra named connections for multi-database (mysql | pgsql).
# Each name maps to db.<name>.* keys; consumed by ConnectionPool.
# Every migration module (src/Migration/<Module>) must be mapped to a
# connection in config/common/migration.php -> 'moduleConnections';
# migrate:module fails without one. `--db=<name>` overrides the
# mapping per run.

